  ],
  "compute_constraints": {
    "max_tokens_per_run": 10000,
    "max_api_calls": 20,
    "budget_warning_threshold": 0.2,
    "strategy_on_budget_warning": "fast_heuristic_scoring_only",
    "hard_abort_threshold": 0.05
  },
  "task_categories": [
    "validation",
    "safety",
    "attestation",
    "guardrails"
  ],
  "safety": {
    "is_safety_layer": true,
    "blocking_authority": true,
    "abort_conditions": [
      "arbiter_score_above_75",
      "tx_value_exceeds_budget",
      "unverified_contract_address",
      "engineer_budget_exhausted",
