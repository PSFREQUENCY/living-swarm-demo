  "erc8183_capabilities": {
    "validate_output": {
      "description": "Scores engineer output for quality and safety (0-100)",
      "version": "1.0",
      "inputs": [
        "analysis_report",
        "tool_calls_log"
      ],
      "outputs": [
        "validation_score",
        "safety_band",
        "approval_or_abort"
      ]
    },
    "score_transaction": {
      "description": "Applies arbiter logic to any proposed on-chain action",
      "version": "1.0",
      "inputs": [
        "tx_params"
      ],
      "outputs": [
        "arbiter_score",
        "band",
        "decision"
      ]
    },
    "attest_onchain": {
      "description": "Calls ArbitersLedger.sol to permanently record safety decision",
      "version": "1.0",
      "inputs": [
        "task_id",
        "score",
        "band"
      ],
      "outputs": [
        "tx_hash"
      ]
    }
